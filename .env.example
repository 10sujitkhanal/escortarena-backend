# Copy this file to .env and fill in the values. .env is ignored by git – never commit real keys.
# Restart the backend after changing it.

# ── Site and URLs ───────────────────────────────────────────
# Local: DJANGO_DEBUG=true. Server: false, plus a long random DJANGO_SECRET_KEY
# (python3 -c "import secrets;print(secrets.token_urlsafe(50))").
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
# Domains this backend answers to (comma separated). Server: yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The website's address: links in emails and the page you return to after paying.
PUBLIC_SITE_URL=http://localhost:3100
# Where PaymentWings sends payment webhooks (/api/payments/paymentwings/webhook) – must be reachable from the internet in production
# (usually the same as PUBLIC_SITE_URL; the website forwards /api to the backend).
PUBLIC_API_URL=http://localhost:3100
# Website addresses allowed to call the API (comma separated). Server: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Extra CSRF-trusted origins besides FRONTEND_ORIGINS (the API domain, so the admin login works)
CSRF_EXTRA_ORIGINS=https://api.escortarea.com
# Lets the backend refresh the website's cached pages. REVALIDATE_SECRET must match frontend/.env.
# Server: http://127.0.0.1:3000/internal/revalidate
NEXT_REVALIDATE_URL=http://127.0.0.1:3100/internal/revalidate
REVALIDATE_SECRET=dev-revalidate-secret
# Live chat across several processes (needed in production)
# REDIS_URL=redis://127.0.0.1:6379/0

# Defaults used when the site is first set up (later changed in Admin → Site settings)
# SITE_NAME=EscortArea
# SITE_COUNTRY=Nepal
# CONTACT_EMAIL=support@yourdomain.com
# FREE_AD_DAYS=30

# ── Email ───────────────────────────────────────────────────
# Name shown as the sender and at the top of every e-mail (default: the site name)
EMAIL_BRAND_NAME=KingOfBabes
# Every e-mail the site sends comes from this address (welcome, password reset, ads, payments, VIP …)
DEFAULT_FROM_EMAIL=info@yourdomain.com
# Support address: shown on the Contact/About pages, receives the contact form, and gets replies to e-mails.
# Used when the site is first set up; after that change it in Admin → Site settings → Contact e-mail.
CONTACT_EMAIL=support@yourdomain.com
# Local: console (e-mails are printed in the terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# aaPanel Mail Server (App Store → Mail Server; create a mailbox, then use its "send mail API"):
# EMAIL_BACKEND=core.mail_backends.BTPanelEmailBackend
# BTPANEL_MAIL_URL=https://<server-ip>:<panel-port>/mail_sys/send_mail_http.json
# BTPANEL_MAIL_FROM=info@yourdomain.com
# BTPANEL_MAIL_PASSWORD=
# BTPANEL_MAIL_VERIFY_SSL=false      # the panel uses a self-signed certificate
# Or any SMTP provider (Brevo, Mailgun, Amazon SES, Zoho …):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# EMAIL_USE_SSL=true          # instead of TLS when the port is 465
# PASSWORD_RESET_TIMEOUT=7200 # seconds a reset link works (2 hours)

# ── PaymentWings (https://app.paymentwings.com → Settings → API) ──
# Public + private key: sandbox keys run in test mode, live keys take real money.
# With both set, payments go through PaymentWings; without them, local development uses the fake test gateway.
PAYMENTWINGS_PUBLIC_KEY=
PAYMENTWINGS_PRIVATE_KEY=
# Webhook key: verifies the payment notices (md5 signature)
PAYMENTWINGS_WEBHOOK_KEY=
# PAYMENTWINGS_BASE_URL=https://api.paymentwings.com

# ── Database ────────────────────────────────────────────────
# true = PostgreSQL with the settings below; false = local SQLite file (db.sqlite3)
USE_POSTGRES=false
POSTGRES_DB=velora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require   # for hosted databases

# ── Cloudflare R2 (public uploads: ad pictures, videos, profile pictures) ──
# true = upload to R2 and serve from CDN_BASE_URL; false = local media/ folder.
# ID documents and chat files always stay private on the server's own disk.
USE_R2=false
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CDN_BASE_URL=https://pub-xxxx.r2.dev
# R2_PREFIX=media            # folder inside the bucket
