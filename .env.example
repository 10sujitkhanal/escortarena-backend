# Copy this file to .env and fill in the values. .env is ignored by git – never commit real keys.

# --- QuickPay (https://manage.quickpay.net) -------------------------------------------
# Settings → Integration:
#   API key      = "API user" key (the key for your API user, not the merchant key)
#   Private key  = "Merchant private key" (used to check that callbacks really come from QuickPay)
# With both set, payments go through QuickPay; without them, local development uses the fake test gateway.
QUICKPAY_API_KEY=
QUICKPAY_PRIVATE_KEY=
# Language of the QuickPay payment window: en, da, de, ...
QUICKPAY_LANGUAGE=en

# Where the browser comes back after paying, and where QuickPay sends its callback.
# QuickPay must be able to reach PUBLIC_API_URL from the internet (use your real domain in production).
PUBLIC_SITE_URL=http://localhost:3100
PUBLIC_API_URL=http://localhost:3100
